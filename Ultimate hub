    local em = sparkTemplate:Clone()
    em.Parent = att
    em.Color = ColorSequence.new(color or Color3.fromRGB(255,180,80))
    em:Emit(24)

    local smoke = Instance.new("ParticleEmitter", att)
    smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
    smoke.Lifetime = NumberRange.new(0.4,1.0)
    smoke.Rate = 0
    smoke:Emit(8)
