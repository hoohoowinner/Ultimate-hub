local function safeCall(fn)
    return function(...)
        local ok2, err = pcall(fn, ...)
        if not ok2 then
            warn("Callback error:", err)
            pcall(function()
                if Rayfield and Rayfield.Notify then
                    Rayfield:Notify({ Title = "Script error", Content = tostring(err), Duration = 5 })
                end
            end)
        end
    end
end

