local function tryServerDelete(target)
    if not target then return false, "no target" end
    local keywords = {"delete","remove","destroy","admin","server","destroyitem","del","removeobject"}
    local remotes = {}
    for _, v in ipairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            local name = v.Name:lower()
            for _, k in ipairs(keywords) do
                if string.find(name, k) then
                    table.insert(remotes, v)
                    break
                end
            end
        end
    end
    for _, r in ipairs(remotes) do
        local ok2, res = pcall(function()
            if r:IsA("RemoteEvent") then
                r:FireServer(target)
                r:FireServer(target.Name)
                r:FireServer(target:GetFullName())
                return true
            elseif r:IsA("RemoteFunction") then
                r:InvokeServer(target)
                return true
            end
        end)
        if ok2 and res then return true, "fired "..r:GetFullName() end
    end
    return false, "no suitable remote found"
end

