-- helper: local AOE fallback (기존 스크립트에서 사용)
local function localAoeApply(hitPos, originPos, force, upBias, aoe)
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    local parts = Workspace:GetPartBoundsInRadius(hitPos, aoe, params)
    for _, p in ipairs(parts) do
        if p and p:IsA("BasePart") and not p.Anchored and p.CanCollide and not p:IsDescendantOf(character) then
            pcall(function()
                local dir = (p.Position - originPos)
                local unit = (dir.Magnitude > 0 and dir.Unit) or Vector3.new(0,1,0)
                p.AssemblyLinearVelocity = unit * (force * 0.35) + Vector3.new(0, upBias * 0.35, 0)
            end)
        end
    end
end
