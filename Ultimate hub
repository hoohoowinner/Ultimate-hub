local function applyScorchDecal(hitPart, hitPos, normal)
    if not hitPart or not hitPart:IsA("BasePart") then return end
    local face = Enum.NormalId.Front
    local nx, ny, nz = normal.X, normal.Y, normal.Z
    local ax = math.abs(nx); local ay = math.abs(ny); local az = math.abs(nz)
    if ay >= ax and ay >= az then
        face = (ny > 0) and Enum.NormalId.Top or Enum.NormalId.Bottom
    elseif ax >= ay and ax >= az then
        face = (nx > 0) and Enum.NormalId.Right or Enum.NormalId.Left
    else
        face = (nz > 0) and Enum.NormalId.Back or Enum.NormalId.Front
    end
    local dec = Instance.new("Decal")
    dec.Name = "RayScorchDecal"
    dec.Texture = "" -- optional scorch texture id
    dec.Transparency = 1
    dec.Face = face
    dec.Parent = hitPart
    Debris:AddItem(dec, 6)
end

-- rod visuals
local originAttachment = nil
local rodPart = nil
local rodGlow = nil
local endPart = nil
local endAttachment = nil
local muzzleLight = nil
local rodOn = false

-- 텍스처 자리표시자 "a" (실사용 시 rbxassetid://ID 로 교체)
local LASER_ROD_TEXTURE = "a"

local function createRodObjects()
    if rodOn then return end
    if not (character and character:FindFirstChild("Head")) then return end
    local head = character.Head

    originAttachment = head:FindFirstChild("EyeLaserOrigin") or Instance.new("Attachment", head)
    originAttachment.Name = "EyeLaserOrigin"
    originAttachment.Position = Vector3.new(0, 0.12, 0.35)

    rodPart = Instance.new("Part")
    rodPart.Name = "LaserRod"
    rodPart.Anchored = true
    rodPart.CanCollide = false
    rodPart.Material = Enum.Material.Neon
    rodPart.Color = coreColor
    rodPart.Transparency = 0
    rodPart.Size = Vector3.new(0.12, 0.12, 1)
    rodPart.Parent = Workspace

    -- 텍스처(Decal) 붙이기: numeric ID가 아니면 스킵
    if LASER_ROD_TEXTURE and LASER_ROD_TEXTURE ~= "" and LASER_ROD_TEXTURE:match("%d+") then
        local faces = { Front = Enum.NormalId.Front, Back = Enum.NormalId.Back, Left = Enum.NormalId.Left, Right = Enum.NormalId.Right, Top = Enum.NormalId.Top, Bottom = Enum.NormalId.Bottom }
        for name, faceEnum in pairs(faces) do
            local dec = Instance.new("Decal")
            dec.Name = "LaserRodDecal_" .. tostring(name)
            dec.Texture = LASER_ROD_TEXTURE
            dec.Face = faceEnum
            dec.Parent = rodPart
        end
    end

    rodGlow = Instance.new("Part")
    rodGlow.Name = "LaserRodGlow"
    rodGlow.Anchored = true
    rodGlow.CanCollide = false
    rodGlow.Material = Enum.Material.Neon
    rodGlow.Color = glowColor
    rodGlow.Transparency = 0.5
    rodGlow.Size = Vector3.new(0.36, 0.36, 1.02)
    rodGlow.Parent = Workspace

    endPart = Instance.new("Part")
    endPart.Name = "LaserEnd"
    endPart.Anchored = true
    endPart.CanCollide = false
    endPart.Size = Vector3.new(0.2,0.2,0.2)
    endPart.Transparency = 1
    endPart.Parent = Workspace

    endAttachment = Instance.new("Attachment", endPart)
    endAttachment.Name = "LaserEndAttach"

    muzzleLight = Instance.new("PointLight", originAttachment.Parent)
    muzzleLight.Name = "LaserMuzzleLight"
    muzzleLight.Color = coreColor
    muzzleLight.Range = 8
    muzzleLight.Brightness = 2

    rodOn = true
end

local function destroyRodObjects()
    pcall(function()
        if rodPart and rodPart.Parent then rodPart:Destroy() end
        if rodGlow and rodGlow.Parent then rodGlow:Destroy() end
        if endPart and endPart.Parent then endPart:Destroy() end
        if muzzleLight and muzzleLight.Parent then muzzleLight:Destroy() end
        if originAttachment and originAttachment.Parent and originAttachment.Name == "EyeLaserOrigin" then
            originAttachment.WorldCFrame = originAttachment.Parent.CFrame * CFrame.new(0,0.12,0.35)
        end
    end)
    rodOn = false
end

local function updateRod(originPos, hitPos)
    local dir = hitPos - originPos
    local length = dir.Magnitude
    if length < 0.2 then length = 0.2 end
    local cf = CFrame.new(originPos, hitPos) * CFrame.new(0,0,-length/2)
    local thickness = clamp(coreThickness + (laserStrength/15000000) * 0.6, 0.06, 1.2)
    rodPart.Size = Vector3.new(thickness, thickness, length)
    rodPart.CFrame = cf
    rodGlow.Size = Vector3.new(thickness * 3.5, thickness * 3.5, length * 1.02)
    rodGlow.CFrame = cf
    endPart.Position = hitPos
    endAttachment.WorldPosition = hitPos
    if muzzleLight then muzzleLight.Range = clamp(length/8, 6, 24); muzzleLight.Color = coreColor end
end

local function spawnRodImpact(hitPos, normal)
    spawnImpactEffects(hitPos, normal or Vector3.new(0,1,0), coreColor)
    local flash = Instance.new("Part")
    flash.Size = Vector3.new(0.4,0.4,0.4)
    flash.Transparency = 1
    flash.Anchored = true
    flash.CanCollide = false
    flash.Position = hitPos
    flash.Parent = Workspace
    local light = Instance.new("PointLight", flash)
    light.Color = coreColor
    light.Range = 6
    light.Brightness = 6
    Debris:AddItem(flash, 0.25)
end

-- ===== startRodLoop + 로컬 프로젝트타일 처리 통합된 동작 =====

local beamRunning = false
local beamLoopConn = nil

local function spawnLocalRodVisual(originCFrame, dir, speed, color)
    local rod = Instance.new("Part")
    rod.Name = "Local_Rod_Visual"
    rod.Size = Vector3.new(0.15, 0.15, 1)
    rod.CFrame = originCFrame * CFrame.new(0, 0, -rod.Size.Z/2)
    rod.Anchored = false
    rod.CanCollide = false
    rod.Material = Enum.Material.Neon
    rod.Color = color or coreColor
    rod.Massless = true
    rod.Parent = Workspace

    local a0 = Instance.new("Attachment", rod); a0.Position = Vector3.new(0,0,rod.Size.Z/2)
    local a1 = Instance.new("Attachment", rod); a1.Position = Vector3.new(0,0,-rod.Size.Z/2)
    local trail = Instance.new("Trail", rod)
    trail.Attachment0 = a0; trail.Attachment1 = a1
    trail.Color = ColorSequence.new(color or coreColor)
    trail.Lifetime = 0.12
    trail.Enabled = true

    local visualSpeed = clamp((speed or 60000) / 1, 0, 5e6)
    rod.AssemblyLinearVelocity = dir.Unit * visualSpeed

    local touchedConn
    touchedConn = rod.Touched:Connect(function(hit)
        if not hit or not hit.Parent then return end
        if character and hit:IsDescendantOf(character) then return end
        spawnImpactEffects(rod.Position, Vector3.new(0,1,0))
        pcall(function()
            if touchedConn then touchedConn:Disconnect() end
            rod:Destroy()
        end)
    end)

    Debris:AddItem(rod, 6)
    return rod
end

local function startRodLoop()
    if beamRunning then return end
    beamRunning = true

    if not spawnRodProjectile then
        createRodObjects()
    else
        destroyRodObjects()
    end

    beamLoopConn = RunService.RenderStepped:Connect(safeCall(function()
        if not (laserActive and holding and character and character:FindFirstChild("Head") and camera) then
            if beamLoopConn then beamLoopConn:Disconnect(); beamLoopConn = nil end
            destroyRodObjects()
            beamRunning = false
            return
        end

        local head = character.Head
        if not head then return end

        local originCFrame = head.CFrame * CFrame.new(0, 0.12, 0.35)

        local now = tick()
        if now - lastLaser < laserCooldown then
            if not spawnRodProjectile and rodOn then
                local dir = camera.CFrame.LookVector
                local params = RaycastParams.new()
                params.FilterDescendantsInstances = { character }
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.IgnoreWater = true
                local ray = Workspace:Raycast(originCFrame.Position, dir * laserRange, params)
                local hitPos = originCFrame.Position + dir * laserRange
                if ray then hitPos = ray.Position end
                updateRod(originCFrame.Position, hitPos)
            end
            return
        end

        lastLaser = now

        local dir = camera.CFrame.LookVector
        local paramsRC = RaycastParams.new()
        paramsRC.FilterDescendantsInstances = { character }
        paramsRC.FilterType = Enum.RaycastFilterType.Exclude
        paramsRC.IgnoreWater = true

        local ray = Workspace:Raycast(originCFrame.Position, dir * laserRange, paramsRC)
        local hitPos = originCFrame.Position + dir * laserRange
        local hitPart, hitNormal = nil, Vector3.new(0,1,0)
        if ray then
            hitPos = ray.Position
            hitPart = ray.Instance
            hitNormal = ray.Normal
        end

        if spawnRodProjectile then
            local paramsToSend = {
                force = laserStrength,
                upBias = laserUpBias,
                aoe = laserAOE,
                range = laserRange,
                cooldown = laserCooldown,
                fling = flingEnabled == true,
                includeObjects = true,
                spawnRod = true,
                powerMultiplier = tonumber(powerMultiplier) or 1,
                lookVector = camera and camera.CFrame.LookVector or nil,
                color = coreColor,
            }

            if LASER_EVENT then
                pcall(function()
                    LASER_EVENT:FireServer(hitPos, hitPart, paramsToSend)
                end)
            end

            local visualSpeed = clamp((laserStrength * (tonumber(powerMultiplier) or 1)) / 40, 200, 5e6)
            spawnLocalRodVisual(originCFrame, dir, visualSpeed, coreColor)
            spawnImpactEffects(originCFrame.Position + dir * 1.5, dir, coreColor)

        else
            if hitPart and hitPart:IsA("BasePart") and not hitPart:IsDescendantOf(character) then
                pcall(function()
                    if hitPart and not hitPart.Anchored then
                        local d = (hitPart.Position - originCFrame.Position)
                        local u = (d.Magnitude > 0 and d.Unit) or Vector3.new(0,1,0)
                        local localForce = clamp(laserStrength * 0.35, 1000, 1000000)
                        hitPart.AssemblyLinearVelocity = u * localForce + Vector3.new(0, clamp(laserUpBias * 0.35, 0, 50000), 0)
                    end
                end)
                spawnRodImpact(hitPos, hitNormal)
                applyScorchDecal(hitPart, hitPos, hitNormal)

                local paramsToSend = {
                    force = laserStrength,
                    upBias = laserUpBias,
                    aoe = laserAOE,
                    range = laserRange,
                    cooldown = laserCooldown,
                    fling = flingEnabled == true,
                    includeObjects = true,
                    spawnRod = false,
                }
                if LASER_EVENT then
                    pcall(function() LASER_EVENT:FireServer(hitPos, hitPart, paramsToSend) end)
                else
                    pcall(localAoeApply, hitPos, originCFrame.Position, laserStrength, laserUpBias, laserAOE)
                end
            else
                spawnRodImpact(hitPos, Vector3.new(0,1,0))
                local paramsToSend = {
                    force = laserStrength,
                    upBias = laserUpBias,
                    aoe = laserAOE,
                    range = laserRange,
                    cooldown = laserCooldown,
                    fling = flingEnabled == true,
                    includeObjects = true,
                    spawnRod = false,
                }
                if LASER_EVENT then
                    pcall(function() LASER_EVENT:FireServer(hitPos, nil, paramsToSend) end)
                else
                    pcall(localAoeApply, hitPos, originCFrame.Position, laserStrength, laserUpBias, laserAOE)
                end
            end

            if rodOn then
                updateRod(originCFrame.Position, hitPos)
            end
        end
    end))
end

